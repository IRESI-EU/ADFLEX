# ADFLEX environment.
#
# Copy this file to `.env.local` and fill it in. `.env.local` is gitignored and
# must stay that way — it holds a database password.
#
# THE PUBLIC SITE DOES NOT NEED ANY OF THIS. With both values unset, every
# public page still builds and renders: /outputs and /news show their empty
# states and the contact form is hidden. Only /admin needs a database.

# Postgres connection string.
#
# Neon:     postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/adflex?sslmode=require
# Supabase: postgresql://postgres.xxx:pass@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# Local:    postgresql://postgres:password@localhost:5432/adflex
#
# Use the POOLED connection string on both Neon and Supabase. The direct one
# opens a connection per serverless instance and exhausts the limit under load.
DATABASE_URL=

# Signs the admin session cookie. At least 32 characters.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Changing this signs everyone out immediately, which is also how you revoke
# every session at once if a laptop goes missing.
SESSION_SECRET=

# The public address of the site, with scheme and no trailing path.
#
#   https://adflex.example.ie
#
# NOT SET YET, AND DELIBERATELY NOT GUESSED. No production domain has been
# supplied for ADFLEX. Until this is set the site omits everything that needs an
# absolute URL — no <link rel="canonical">, no Open Graph URL, an empty
# /sitemap.xml and no Sitemap: line in /robots.txt. Nothing else is affected and
# no page changes. Set it at launch and all four start working.
#
# A wrong value is worse than none: a canonical link pointing at a domain that
# does not exist tells search engines the real page is somewhere else.
#
# READ AT BUILD TIME, NOT AT REQUEST TIME. Unlike DATABASE_URL and
# SESSION_SECRET, this is a NEXT_PUBLIC_ variable: its value is inlined during
# `next build`, and /robots.txt and /sitemap.xml are generated then too.
# Changing it therefore needs a rebuild — restarting the server picks up
# nothing. Verified by building with it set, starting without it, and finding
# the built-in value still served.
NEXT_PUBLIC_SITE_URL=
